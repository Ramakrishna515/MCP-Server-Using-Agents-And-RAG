# Copy to .env and fill in keys (server auto-loads via --env-file)
# Free options: xAI (console.x.ai) and TinyFish (search.tinyfish.ai)

# LLM Providers (at least one required for chat)
XAI_API_KEY=xai-...
XAI_MODEL=grok-4.1-fast-non-reasoning

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (free key from Google AI Studio) — default RAG answer model
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.6-flash
# Google Gemini embeddings model (used to build the vector index)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# TinyFish free web-search API
TINYFISH_API_KEY="sk-tinyfish-sf6PlAiBsbeJHRpKe54W-AoGRKuKuiFC"

# Chat portal
PORT=3000