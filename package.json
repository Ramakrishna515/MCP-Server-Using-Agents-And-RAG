{
  "name": "build-mcp-server",
  "version": "1.0.0",
  "description": "A custom MCP server connected to a free LLM (Grok)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "server": "node dist/server.js",
    "client": "node dist/client.js",
    "dev": "npm run build && npm run server",
    "test": "npm run build && node dist/test.js",
    "web": "npm run build && node --env-file-if-exists=.env dist/http.js",
    "web:watch": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
